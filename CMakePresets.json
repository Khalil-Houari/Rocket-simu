{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}-gcc",
      "environment": {
        "PATH": "C:/msys64/ucrt64/bin;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "C:/msys64/ucrt64/bin/g++.exe",
        "CMAKE_MAKE_PROGRAM": "C:/msys64/ucrt64/bin/ninja.exe"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Environnement Debug",
      "description": "Sans optimisation, avec symboles pour GDB",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "simulation-release",
      "inherits": "base",
      "displayName": "Environnement Simulation",
      "description": "Optimisation extrême (O3, pas d'asserts)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-debug",
      "configurePreset": "debug",
      "displayName": "Compiler : Debug & Tests"
    },
    {
      "name": "build-simulation",
      "configurePreset": "simulation-release",
      "displayName": "Compiler : Simulation Rapide"
    }
  ],
  "testPresets": [
    {
      "name": "run-tests",
      "configurePreset": "debug",
      "displayName": "Exécuter les tests unitaires",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true
      }
    }
  ]
}